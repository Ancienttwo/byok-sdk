engine-strict=true

# Run one workspace package at a time for every `pnpm -r` task (locally and in
# CI, which invokes `pnpm -r build/typecheck/test` directly).
#
# Why: each package's `test` script is a bare `vitest run`, and vitest sizes its
# own fork pool from the host CPU count. Running the packages in parallel means
# N packages x ~ncpu forks each, which oversubscribes the machine. The client's
# timing-sensitive tests that spawn real child processes and bind real sockets
# (src/__tests__/daemon-control-socket.test.ts, pi-adapter.test.ts,
# unknown-message-type-tolerance.test.ts) then get starved past their timeout
# and fail intermittently -- reproduced here at roughly 1 in 4 full
# `pnpm -r test` runs.
#
# Serializing at the workspace level is preferred over shrinking one package's
# vitest pool: vitest still parallelises inside the single package that is
# running, so it keeps saturating the box, and the fix does not decay as more
# packages or heavier suites are added. An experiment capping only
# @byok/client's maxForks still flaked 2 of 3 runs, because the other packages'
# pools were the pressure.
#
# This removes the repo's SELF-INFLICTED share of CPU pressure only. It is not
# sufficient on its own: under heavy external load (measured at load average
# ~12-14 on a 12-core machine) the same tests still timed out even fully
# serialized, which is why packages/client/vitest.config.ts also raises that
# package's timeout floor. Treat the two as one fix.
#
# Measured cost on a 12-core machine: build (~2.7-3.0s) and typecheck
# (~1.8-2.2s) are unchanged within run-to-run noise -- both are dominated by
# the single largest package -- and `pnpm -r test` wall time is unchanged
# (~18-22s either way).
workspace-concurrency=1
