{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byok-sdk.dev/schemas/agent-memory-a7-result.v1.json",
  "title": "A7 revision result (documentation only)",
  "$comment": "Reference documentation only. The runner, verifier and comparison do not execute this schema; verify.mjs enforces evidence semantics with the pinned strict checker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "role", "before", "revision", "mode", "storageProfile", "helperManifestDigest", "seed", "triggers", "evidence", "status", "cuts", "completeReceipts", "acked", "cleanup", "failures", "evidenceDigest"],
  "properties": {
    "schema": { "const": "byok.a7/v1" },
    "role": { "enum": ["before", "after"] },
    "before": { "const": "04add5d414bbe6ed0301f1bded3c6a40cb76dfa0" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "mode": { "enum": ["process-kill", "owner-vm-power-cut"] },
    "storageProfile": { "$ref": "#/$defs/storageProfile" },
    "helperManifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "seed": { "type": "integer", "minimum": 1 },
    "triggers": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(host:(fetch|complete|acked)@[1-9][0-9]*|delay:[1-9][0-9]*ms)$" } },
    "evidence": { "enum": ["harness-validation-not-A7", "profile-limited-power-loss", "profile-limited-vm-power-off"] },
    "status": { "enum": ["passed", "failed"] },
    "cuts": { "type": "array", "items": { "$ref": "#/$defs/cut" } },
    "completeReceipts": { "type": "integer", "minimum": 0 },
    "acked": { "type": "integer", "minimum": 0 },
    "cleanup": { "type": ["array", "null"], "items": { "type": "string" } },
    "failures": { "type": "array" },
    "evidenceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "storageProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "osBuild", "disk", "virtualController", "cacheMode", "filesystem", "hypervisor", "hostStorage", "cutMechanism", "dropsUnflushedWrites"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "osBuild": { "type": "string", "minLength": 1 },
        "disk": { "type": "string", "minLength": 1 },
        "virtualController": { "type": "string", "minLength": 1 },
        "cacheMode": { "type": "string", "minLength": 1 },
        "filesystem": { "type": "string", "minLength": 1 },
        "hypervisor": { "type": "string", "minLength": 1 },
        "hostStorage": { "type": "string", "minLength": 1 },
        "cutMechanism": { "type": "string", "minLength": 1 },
        "dropsUnflushedWrites": { "type": "boolean" }
      }
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariants", "window", "leftovers", "leaseMarkers"],
      "properties": {
        "invariants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "details"],
            "properties": {
              "id": { "enum": ["I1", "I2", "I3", "I4", "I5"] },
              "status": { "enum": ["held", "violated"] },
              "details": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "window": { "enum": ["no-intent", "no-record", "applying", "terminal-without-receipt", "receipt-without-ack", "acked"] },
        "leftovers": { "type": "integer", "minimum": 0 },
        "leaseMarkers": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
