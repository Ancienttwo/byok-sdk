+// Temporary fixture-only admission diagnostic; never logs identity or request bytes.
+type UnicodeAdmissionStage = 'offer-enter' | 'message-preflight-before' | 'message-preflight-after'
+  | 'result-preflight-before' | 'result-preflight-after' | 'adapter-prepare-before'
+  | 'adapter-prepare-after' | 'start-before' | 'start-after'
+  | 'home-acquire-before' | 'home-acquire-after' | 'home-initialize-before' | 'home-initialize-after'
+  | 'result-store-before' | 'result-store-after' | 'manifest-before' | 'manifest-after'
+  | 'claim-before' | 'instruction-after';
+const unicodeAdmissionStarts = new WeakMap<object, number>();
+function traceUnicodeAdmission(payload: AcceptedOfferPayload, stage: UnicodeAdmissionStage): void {
+  try {
+    let began = unicodeAdmissionStarts.get(payload);
+    if (began === undefined) {
+      const instruction = offeredInstruction(payload);
+      if (typeof instruction !== 'string' || !instruction.includes('😀'.repeat(4096) + ' CURRENT-END')
+        || instruction.split('😀').length !== 4097) return;
+      began = performance.now();
+      unicodeAdmissionStarts.set(payload, began);
+    }
+    const elapsedMs = Math.max(0, Math.round(performance.now() - began));
+    console.log('BYOK_UNICODE_STAGE ' + JSON.stringify({ stage, elapsedMs }));
+  } catch { /* Diagnostic failures must not change admission behavior. */ }
+}
