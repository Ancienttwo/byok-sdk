{
  "name": "@byok-sdk/testkit",
  "version": "0.0.0",
  "private": true,
  "description": "BYOK SDK headless device simulator: protocol-level pairing, token renewal, presence, and the built-in negative assertions; repository-internal, consumed by @byok-sdk/conformance, never published",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@byok-sdk/core": "workspace:*",
    "@byok-sdk/protocol": "workspace:*"
  }
}
