{
  "name": "@byok-sdk/protocol",
  "version": "0.33.0",
  "description": "BYOK SDK wire protocol: envelope schema, message types, and codec helpers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ancienttwo/byok-sdk.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/Ancienttwo/byok-sdk/issues"
  },
  "homepage": "https://github.com/Ancienttwo/byok-sdk#readme",
  "engines": {
    "node": ">=24.22.1"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./agent-memory": {
      "types": "./dist/agent-memory.d.ts",
      "import": "./dist/agent-memory.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "byok-protocol-previous": "https://registry.npmjs.org/@byok-sdk/protocol/-/protocol-0.32.0.tgz"
  }
}
