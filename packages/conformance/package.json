{
  "name": "@byok-sdk/conformance",
  "version": "0.0.0",
  "private": true,
  "description": "The composition conformance suites: one assertion source every BYOK composition must pass, never published",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@byok-sdk/cloud": "workspace:*",
    "@byok-sdk/core": "workspace:*"
  }
}
