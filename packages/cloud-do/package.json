{
  "name": "@byok-sdk/cloud-do",
  "version": "0.41.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "description": "Cloudflare Durable Object session host for native pi-durable storage and execution",
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/check-dist.mjs && wrangler deploy --dry-run --outdir dist-worker",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test test/recovery-walltime.node.mjs test/wake-alarm-retry.node.mjs test/wake-events-walltime.node.mjs test/check-dist.node.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/chord": "1.5.2"
  },
  "devDependencies": {
    "@byok-sdk/client": "workspace:*",
    "@byok-sdk/keys": "workspace:*",
    "@cloudflare/workers-types": "5.20261106.1",
    "miniflare": "5.20261104.0-beta",
    "esbuild": "0.28.1",
    "wrangler": "4.158.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ancienttwo/byok-sdk.git",
    "directory": "packages/cloud-do"
  },
  "bugs": {
    "url": "https://github.com/Ancienttwo/byok-sdk/issues"
  },
  "homepage": "https://github.com/Ancienttwo/byok-sdk#readme",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
