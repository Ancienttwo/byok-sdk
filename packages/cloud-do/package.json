{
  "name": "@byok-sdk/cloud-do",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0" },
  "description": "Private Cloudflare DO SQLite host for native pi-durable storage",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test test/recovery-walltime.node.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-durable": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/chord": "1.0.0"
  },
  "devDependencies": {
    "@byok-sdk/keys": "workspace:*",
    "@cloudflare/workers-types": "5.20260811.1",
    "miniflare": "5.20260811.1-alpha",
    "esbuild": "0.28.1",
    "wrangler": "4.123.0"
  }
}
