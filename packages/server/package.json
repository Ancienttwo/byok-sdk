{
  "name": "@byok-sdk/server",
  "version": "0.30.1",
  "description": "BYOK SDK server: single-product, single-tenant embedded coordinator over @byok-sdk/cloud — wake-driven HTTP long-poll, memory or single-process SQLite storage.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ancienttwo/byok-sdk.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/Ancienttwo/byok-sdk/issues"
  },
  "homepage": "https://github.com/Ancienttwo/byok-sdk#readme",
  "engines": {
    "node": ">=24.22.1"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@byok-sdk/cloud": "workspace:*",
    "@byok-sdk/core": "workspace:*",
    "@byok-sdk/protocol": "workspace:*",
    "@hono/node-server": "^2.0.10",
    "hono": "^4.12.30"
  },
  "devDependencies": {
    "@byok-sdk/conformance": "workspace:*"
  }
}
