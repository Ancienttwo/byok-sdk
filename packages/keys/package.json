{
  "name": "@byok-sdk/keys",
  "version": "0.3.3-rc.1",
  "description": "BYOK SDK key management: provider profiles, credential-backed auth headers, and direct provider transports",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ancienttwo/byok-sdk.git",
    "directory": "packages/keys"
  },
  "bugs": {
    "url": "https://github.com/Ancienttwo/byok-sdk/issues"
  },
  "homepage": "https://github.com/Ancienttwo/byok-sdk#readme",
  "engines": {
    "node": ">=22.22.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "byok-pi-provider-launcher": "./dist/bin/pi-provider-launcher.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "bun run build",
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@byok-sdk/core": "workspace:*",
    "zod": "^4.4.3"
  }
}
