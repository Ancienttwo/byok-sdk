{
  "productId": "salesko",
  "productName": "Salesko",
  "serverUrl": "https://salesko.example",
  "storeDir": "/Users/x/.salesko/computer",
  "agentHome": { "hostStorageRoot": "/Users/x/Library/Application Support/Salesko" },
  "runtimeAllowlist": ["pi", "claude"],
  "runtimes": {
    "pi": { "agentUserContext": "excluded" },
    "claude": { "agentUserContext": "excluded", "agentSessionPersistence": "disabled" }
  },
  "toolAuthorization": {
    "default": "auto",
    "fileScope": {
      "mode": "workspaces",
      "roots": [{ "id": "workspace", "path": "/Users/x/Projects/salesko", "access": "read" }]
    }
  }
}
