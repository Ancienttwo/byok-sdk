{
  "name": "@byok-sdk/client",
  "version": "0.31.0",
  "byok": {
    "piRuntimePin": "1.4.0"
  },
  "description": "BYOK SDK client daemon: runs on the end user's machine, pairs with a SaaS server, and drives a local coding-agent runtime",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ancienttwo/byok-sdk.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/Ancienttwo/byok-sdk/issues"
  },
  "homepage": "https://github.com/Ancienttwo/byok-sdk#readme",
  "engines": {
    "node": ">=24.22.1"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "byok-agent": "./dist/bin/byok-agent.js",
    "byok-agent-message-mcp": "./dist/bin/byok-agent-message-mcp.js",
    "byok-agent-result-mcp": "./dist/bin/byok-agent-result-mcp.js",
    "byok-agent-memory-mcp": "./dist/bin/byok-agent-memory-mcp.js",
    "byok-agent-team-mcp": "./dist/bin/byok-agent-team-mcp.js",
    "byok-pi-durable": "./dist/bin/byok-pi-durable.js",
    "byok-pi-prepared": "./dist/bin/byok-pi-prepared.js",
    "byok-pi-rpc": "./dist/bin/byok-pi-rpc.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./agent-memory": {
      "types": "./dist/agent-memory/index.d.ts",
      "import": "./dist/agent-memory/index.js"
    },
    "./assertion-client": {
      "types": "./dist/assertion-client/index.d.ts",
      "import": "./dist/assertion-client/index.js"
    },
    "./mcp-server": {
      "types": "./dist/mcp-server/index.d.ts",
      "import": "./dist/mcp-server/index.js"
    },
    "./mcp-server/http": {
      "types": "./dist/mcp-server/http.d.ts",
      "import": "./dist/mcp-server/http.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "upgrade-manifest.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/check-adapters-entry.mjs --build-todo && node scripts/build-todo-assets.mjs && node scripts/build-pi-export-assets.mjs && node scripts/build-sealed-host.mjs && tsc -p tsconfig.build.json && node scripts/check-adapters-entry.mjs && node scripts/check-agent-memory-entry.mjs && node scripts/check-hermes-session-entry.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:runtime-contract": "vitest run --config src/__tests__/runtime-contract/vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.vendor.json",
    "smoke:adapters": "node scripts/adapter-task-smoke.mjs",
    "smoke:codex-app-server": "node scripts/codex-app-server-real.mjs",
    "audit:adapter-task-smoke": "node scripts/adapter-task-smoke.mjs",
    "audit:credentials": "node scripts/linux-credential-audit.mjs",
    "clean": "rm -rf dist",
    "build:agent-memory-helper": "node scripts/build-agent-memory-helper.mjs && node scripts/check-agent-memory-helper-build.mjs"
  },
  "optionalDependencies": {
    "koffi": "3.2.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@byok-sdk/core": "workspace:*",
    "@byok-sdk/protocol": "workspace:*",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@modelcontextprotocol/client": "2.0.0",
    "pi-web-access": "0.45.0",
    "undici": "8.12.3",
    "jiti": "2.7.0",
    "yaml": "2.8.3",
    "@juicesharp/rpiv-i18n": "2.15.0",
    "@juicesharp/rpiv-config": "2.15.0",
    "typebox": "1.3.27",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/chord": "1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@byok-sdk/server": "workspace:*",
    "@hono/node-server": "^2.0.10",
    "esbuild": "0.28.1",
    "pi-subagents": "0.60.0"
  },
  "imports": {
    "#byok-hermes-session": { "types": "./dist/adapters/hermes/hermes-session-runtime.d.ts", "default": "./dist/adapters/hermes/hermes-session-runtime.js" },
    "#byok-acp-runtime": {
      "types": "./dist/runtime/acp-session-runtime.d.ts",
      "default": "./dist/runtime/acp-session-runtime.js"
    },
    "#byok-pi-runtime-host": {
      "types": "./dist/bin/pi-runtime-host.d.ts",
      "default": "./dist/bin/pi-runtime-host.js"
    },
    "#byok-pi-todo-runtime": {
      "types": "./dist/bin/pi-todo-runtime.d.ts",
      "default": "./dist/bin/pi-todo-runtime.js"
    },
    "#byok-pi-runtime-host-sealed": {
      "types": "./dist/bin/pi-runtime-host-sealed.d.ts",
      "default": "./dist/bin/pi-runtime-host-sealed.js"
    }
  }
}
