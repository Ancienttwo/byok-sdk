      "id": "native-assets-archive-path",
      "impact": "additive",
      "summary": "copySdkNativeAssets accepts an optional absolute archivePath to a local copy of the pinned Koffi tgz. It runs the same SHA-512 integrity and addon SHA-256 checks and never calls fetch. Without it, behavior is unchanged.",
      "migration": "https://github.com/Ancienttwo/byok-sdk/issues/1567",
      "items": [
        "export:@byok-sdk/client#CopySdkNativeAssetsOptions"
      ]
    },
    {
      "id": "keys-profile-store-migration",
      "impact": "additive",
      "summary": "migrateProviderProfileStore migrates a keys SQLite profile store with an earlier provider_kind CHECK set in one transaction, keeping profiles and credential-store key references. Call it before opening the store; opening never migrates.",
      "migration": "docs/releases/host-upgrade-0.41.0.md#stores",
      "items": [
        "export:@byok-sdk/keys#ProviderProfileStoreMigration",
        "export:@byok-sdk/keys#migrateProviderProfileStore"
      ]
    }
