  "entries": [
    {
      "id": "local-tool-approval-host-only",
      "impact": "breaking",
      "summary": "Tool-authorization approvals are Host-only by default (#1101): the control socket and byok-agent approve can no longer approve them; rejection is unaffected. Set DaemonConfig.localToolApproval: 'allow' to restore local tool-authorization approval.",
      "migration": "docs/security.md#3-shared-approval-path",
      "items": [
        "export:@byok-sdk/client#APPROVAL_REQUIRES_HOST",
        "export:@byok-sdk/client#ApprovalKind",
        "export:@byok-sdk/client#DaemonConfig",
        "export:@byok-sdk/client#DiagnosticsSnapshot",
        "export:@byok-sdk/client#LocalToolApprovalPolicy"
      ]
    },
    {
      "id": "daemon-config-schema",
      "impact": "additive",
      "summary": "DaemonConfig has a generated, versioned JSON schema (daemon-config.schema.json beside the client package.json) and one validator for config files and createDaemon. Unknown fields are warnings, never rejected at runtime (Q4'); `byok-agent config check [--strict] [--json]` and checkDaemonConfig validate a config and report its effective values (store, Agent-home and scratch directories with the socket budget, MCP servers, memory helper, runtime isolation, tool-authorization mode). Daemon.status().config returns the same report. Each top-level DaemonConfig field is now a config:<field> manifest item. Nothing to change; run `byok-agent config check --strict` in CI to catch typos. AgentEgressConfig.policy is optional, as config files already wrote it (`\"agentEgress\": {}` selects the client default policy).",
      "migration": "docs/spec.md#daemon-configuration-contract-1094",
      "items": [
        "config:agentEgress",
        "config:agentHome",
        "config:agentMemory",
        "config:agentMemoryExport",
        "config:agentMemoryHelperAssetRoot",
        "config:agentMemoryIntents",
        "config:agentMemoryMcp",
        "config:artifactLimits",
        "config:authRequestDeadlineMs",
        "config:branding",
        "config:codexSandbox",
        "config:dangerouslyAllowInsecureRemote",
        "config:deviceAssertion",
        "config:deviceCredentials",
        "config:deviceName",
        "config:durablePi",
        "config:inputPreparation",
        "config:localAgentRelease",
        "config:localToolApproval",
        "config:machineId",
        "config:maxConcurrentReaderAttemptsPerAgentHome",
        "config:maxInlineEventBytes",
        "config:maxTaskOutputBytes",
        "config:mcpToolsets",
        "config:nativeAssetRoot",
        "config:piByokLauncher",
        "config:presence",
        "config:productId",
        "config:productName",
        "config:progressBatch",
        "config:providerProvisioning",
        "config:runtimeAllowlist",
        "config:runtimePreference",
        "config:sdkHelperHost",
        "config:serverUrl",
        "config:serviceEnrollment",
        "config:shutdownGraceMs",
        "config:startupTimeoutMs",
        "config:storage",
        "config:storeDir",
        "config:toolAuthorization",
        "export:@byok-sdk/client#AgentEgressConfig",
        "export:@byok-sdk/client#DAEMON_CONFIG_SCHEMA_VERSION",
        "export:@byok-sdk/client#DaemonConfigCheck",
        "export:@byok-sdk/client#DaemonConfigCheckOptions",
        "export:@byok-sdk/client#DaemonConfigInvalidError",
        "export:@byok-sdk/client#DaemonConfigIssue",
        "export:@byok-sdk/client#DaemonConfigIssueCode",
        "export:@byok-sdk/client#DaemonConfigSource",
        "export:@byok-sdk/client#DaemonConfigValidation",
        "export:@byok-sdk/client#DaemonEffectiveConfig",
        "export:@byok-sdk/client#DaemonEffectiveMcpServer",
        "export:@byok-sdk/client#DaemonEffectiveRuntime",
        "export:@byok-sdk/client#DaemonMemoryHelperResolution",
        "export:@byok-sdk/client#DaemonStatus",
        "export:@byok-sdk/client#checkDaemonConfig",
        "export:@byok-sdk/client#validateDaemonConfig"
      ]
    },
    {
      "id": "daemon-config-validation",
      "impact": "breaking",
      "summary": "Daemon construction now validates DaemonConfig against the schema: a missing required field or a value of the wrong JSON type or literal throws DaemonConfigInvalidError (some fields were previously passed through unchecked), and the bin reports every config error at once. DaemonConfigFieldRemovedError gains a required `migration` (constructor third argument) pointing at the removed-field table; a removed field such as workspaceRoot keeps throwing it. Fix the reported fields; a Host that constructs DaemonConfigFieldRemovedError itself passes the migration anchor.",
      "migration": "docs/spec.md#removed-daemonconfig-fields",
      "items": [
        "export:@byok-sdk/client#DaemonConfigFieldRemovedError"
      ]
    },
    {
      "id": "auth-renewal-floor",
      "impact": "additive",
      "summary": "Token renewal keeps a minimum gap between proactive renewals, so a fast device clock or a server TTL under the renewal margin no longer loops renewals and keychain writes (#1114). The declarations change only by private AuthManager members; no Host action.",
      "migration": "https://github.com/Ancienttwo/byok-sdk/pull/1131",
      "items": [
        "export:@byok-sdk/client#BlobClient",
        "export:@byok-sdk/client#InstallSkillPacksOptions"
      ]
    }
  ],
