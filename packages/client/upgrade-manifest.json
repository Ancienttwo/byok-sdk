    {
      "id": "daemon-embedded-pairing",
      "impact": "additive",
      "summary": "Daemon.pairEmbedded(server) pairs an embedded Host's daemon against its in-process server and reconciles an existing enrollment; every other state throws the new EmbeddedPairingError (enrollment_missing, device_unknown, re_pair_required, store_not_bound) and writes nothing. EmbeddedPairingServer is the structural server type it reads. Daemon.whenOpen({ signal }) resolves on running/open and rejects with DaemonHaltError, the new DaemonNotOpenError (stopped, crashed) or signal.reason. Both Daemon members are required, so a Host test double typed as Daemon adds them (#1840).",
      "migration": "docs/releases/host-upgrade-next-minor.md#embedded-pairing-and-connection-wait",
      "items": [
        "export:@byok-sdk/client#Daemon",
        "export:@byok-sdk/client#DaemonNotOpenError",
        "export:@byok-sdk/client#EmbeddedPairingError",
        "export:@byok-sdk/client#EmbeddedPairingServer"
      ]
    },
    {
      "id": "daemon-when-task-settled",
      "impact": "additive",
      "summary": "Daemon.whenTaskSettled(taskId, { signal }) resolves DaemonTaskSettlement (terminal, delivery, disposal) once the terminal's first outbound settlement was published locally and the runtime owner reported its first disposal outcome; disposal is failed exactly when runtime-disposal-failed was emitted and none when the daemon holds no runtime for the task, including every task settled before a restart. A task with no journal row and no in-memory record rejects with the new DaemonTaskUnknownError (daemon_task_unknown). The Daemon member is required, so a Host test double typed as Daemon adds it (#1838).",
      "migration": "docs/releases/host-upgrade-next-minor.md#per-task-settlement-awaitable",
      "items": [
        "export:@byok-sdk/client#DaemonTaskSettlement",
        "export:@byok-sdk/client#DaemonTaskTerminal",
        "export:@byok-sdk/client#DaemonTaskUnknownError"
      ]
    },
    {
      "id": "testing-in-memory-device-credential-backend",
      "impact": "additive",
      "summary": "@byok-sdk/client/testing exports InMemoryDeviceCredentialBackend, a DeviceCredentialBackend held in memory for a Host's tests. A Host that hand-rolls a memory backend injects this one as deviceCredentials; no runtime Host change is required. The host-execution-core example's tests import it instead of the repo's removed scripts/testing helper.",
      "migration": "docs/releases/host-upgrade-next-minor.md#in-memory-device-credential-backend-1844",
      "items": [
        "export:@byok-sdk/client/testing#InMemoryDeviceCredentialBackend",
        "example:host-execution-core"
      ]
    },
