  "entries": [
    {
      "id": "dsh-adapter",
      "impact": "additive",
      "summary": "Add DshAdapter, a DeepSeek Harness (dsh) runtime adapter over ACP (`dsh --profile acp`) reached by the custom harness id dsh (#1258). The Host constructs it with an SDK-owned persistent home that is not ~/.dsh and a provider, model and keyEnv selection; it resumes native sessions, attaches task MCP toolsets including result documents, declines auto and file-scope tasks before claim, and runs on darwin and linux. fakeRuntimeAdapter accepts 'dsh'. Nothing changes for a Host that does not construct it.",
      "migration": "https://github.com/Ancienttwo/byok-sdk/issues/1258",
