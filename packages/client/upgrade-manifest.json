    {
      "id": "model-route-host-entry-default-thinking-level",
      "impact": "additive",
      "summary": "ModelRouteHostEntry accepts an optional default_thinking_level that a draft takes when the entry is selected. modelRouteContext throws when the level is not one the entry's config supports; an entry without the field behaves as before.",
      "migration": "docs/releases/host-upgrade-next-minor.md#host-model-route-entries-can-declare-a-default-thinking-level",
      "items": [
        "export:@byok-sdk/keys/model-route#ModelRouteHostEntry"
