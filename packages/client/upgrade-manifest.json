  "entries": [
    {
      "id": "provider-store-credential-namespace",
      "impact": "breaking",
      "acceptance": "new-path-repair",
      "summary": "@byok-sdk/keys requires a credential namespace in each provider store. Existing stores return PROVIDER_STORE_SCHEMA_STALE. Preserve the old database, create a fresh store on a new path and re-enter provider keys. Automatic credential cleanup requires a recognized namespaced retired store.",
      "migration": "docs/releases/host-upgrade-next-minor.md#provider-store-credential-namespace",
      "items": [
        "export:@byok-sdk/keys#InMemoryProviderProfileStore",
        "export:@byok-sdk/keys#ProviderProfileStore",
        "export:@byok-sdk/keys#SqliteProviderProfileStore",
        "export:@byok-sdk/keys#removeRetiredProviderCredentials",
        "store:keys-profile-store"
      ]
    },
    {
      "id": "provider-credential-scope-binding",
      "impact": "breaking",
      "summary": "ProviderRegistry, applySealedProviderProvisioning, runPiProviderLauncher and the bundled Pi launcher scope the Host's base credential store to the selected database's namespace. Pass the base scope and upgrade the Host and launcher together.",
      "migration": "docs/releases/host-upgrade-next-minor.md#provider-store-credential-namespace",
      "items": [
        "behavior:provider-credential-scope-binding"
      ]
    },
    {
      "id": "model-discovery-connection-fields",
      "impact": "breaking",
      "summary": "ModelDiscoveryConnection uses auth_mode and base_url to match provider profiles. Remove providerKind from the connection object and keep adapter.",
      "migration": "docs/releases/host-upgrade-next-minor.md#model-discovery-connection-fields",
      "items": [
        "export:@byok-sdk/keys#ModelDiscoveryConnection"
      ]
    },
    {
      "id": "model-list-unreachable",
      "impact": "additive",
      "summary": "discoverProviderModels reports transport failures while connecting or reading a successful response body as MODEL_LIST_UNREACHABLE and preserves the original error as the cause.",
      "migration": "CHANGELOG.md#unreleased",
      "items": [
        "export:@byok-sdk/keys#BYOK_KEYS_ERROR_CODES"
      ]
    },
    {
      "id": "bot-testing-runner-injection",
      "impact": "breaking",
      "summary": "Each bot-collaboration testing vector now requires the Host's describe, it and expect as its first argument. Update every vector call to pass these test runner APIs, including the asymmetric matchers.",
      "migration": "packages/bot-collaboration/README.md#shared-vector-migration",
      "items": [
        "export:@byok-sdk/bot-collaboration/testing#VectorMatchers",
        "export:@byok-sdk/bot-collaboration/testing#VectorTestApi",
        "export:@byok-sdk/bot-collaboration/testing#cardCallVectors",
        "export:@byok-sdk/bot-collaboration/testing#cardVectors",
        "export:@byok-sdk/bot-collaboration/testing#coalesceVectors",
        "export:@byok-sdk/bot-collaboration/testing#commitVectors",
        "export:@byok-sdk/bot-collaboration/testing#deliveryVectors",
        "export:@byok-sdk/bot-collaboration/testing#deviceVectors",
        "export:@byok-sdk/bot-collaboration/testing#homeVectors",
        "export:@byok-sdk/bot-collaboration/testing#replyVectors",
        "export:@byok-sdk/bot-collaboration/testing#retentionVectors",
        "export:@byok-sdk/bot-collaboration/testing#roomVectors",
        "export:@byok-sdk/bot-collaboration/testing#routineVectors",
        "export:@byok-sdk/bot-collaboration/testing#settlementVectors",
        "export:@byok-sdk/bot-collaboration/testing#syncVectors"
      ]
    },
    {
      "id": "bot-persona-and-autonomy-context",
      "impact": "additive",
      "summary": "Bot collaboration Hosts can render additional persona home files and run an idempotent post-write hook; context rules now receive the Bot's optional autonomy for observe-mode instructions.",
      "migration": "packages/bot-collaboration/README.md#persona-delivery-failures",
      "items": [
        "export:@byok-sdk/bot-collaboration#BotPersonaProjectionContext",
        "export:@byok-sdk/bot-collaboration#BotPersonaProjectionOptions",
        "export:@byok-sdk/bot-collaboration#createBotPersonaProjection",
        "export:@byok-sdk/bot-collaboration/host-kit#BotTurnInstructionOptions",
        "export:@byok-sdk/bot-collaboration/host-kit#outcomeSchema",
        "export:@byok-sdk/bot-collaboration/rules#syncTurn"
      ]
    },
    {
      "id": "mcp-toolset-exposure-config",
      "impact": "additive",
      "summary": "Set exposure to search on a @byok-sdk/client DaemonConfig.mcpToolsets entry to opt in on a qualified runtime. Prepared inputs require direct exposure, which is the default.",
      "migration": "https://github.com/Ancienttwo/byok-sdk/issues/2396",
      "items": [
        "config:mcpToolsets",
        "export:@byok-sdk/client#McpToolsetConfig"
      ]
    },
    {
      "id": "mcp-hub-sdk-helper",
      "impact": "additive",
      "summary": "Handle mcp-hub in exhaustive SdkReservedHelperKind switches and include byok-mcp-hub in fixed distribution lists. Single-file Hosts continue routing SDK helpers through runSdkReservedHelperCommand.",
      "migration": "https://github.com/Ancienttwo/byok-sdk/issues/2396",
      "items": [
        "bin:byok-mcp-hub",
        "export:@byok-sdk/client#SdkReservedHelperKind"
      ]
    },
    {
      "id": "runtime-provider-key-resolvers",
      "impact": "breaking",
      "summary": "dsh and agy in @byok-sdk/client and @byok-sdk/client/adapters require a Host resolveKey callback for each authenticated spawn. Remove dsh model.keyEnv. Plain JSON configuration cannot start these runtimes.",
      "migration": "docs/releases/host-upgrade-next-minor.md#dsh-and-agy-provider-keys",
      "items": [
        "config:runtimes",
        "export:@byok-sdk/client#AgyAdapter",
        "export:@byok-sdk/client#AgyAdapterOptions",
        "export:@byok-sdk/client#DshAdapterOptions",
        "export:@byok-sdk/client#DshModelSelection",
        "export:@byok-sdk/client/adapters#AgyAdapter",
        "export:@byok-sdk/client/adapters#AgyAdapterOptions",
        "export:@byok-sdk/client/adapters#DshAdapterOptions",
        "export:@byok-sdk/client/adapters#DshModelSelection",
        "export:@byok-sdk/client/adapters#RuntimeAdaptersRuntimes"
      ]
    },
    {
      "id": "runtime-provider-key-environment",
      "impact": "breaking",
      "summary": "dsh and agy in @byok-sdk/client and @byok-sdk/client/adapters authenticate through resolveKey and omit authPresent from installation detection. Remove provider key names from runtimeEnvironment.pass and allow, and use the Host store to determine whether an account has a saved key.",
      "migration": "docs/releases/host-upgrade-next-minor.md#dsh-and-agy-provider-keys",
      "items": [
        "behavior:runtime-provider-key-environment"
      ]
    },
    {
      "id": "agent-memory-home-resident-check",
      "impact": "additive",
      "summary": "@byok-sdk/client/agent-memory checkAgentMemoryHome supports resident scope so embedded Hosts can check MEMORY.md on device sync without opening the helper or walking notes.",
      "migration": "docs/releases/host-upgrade-next-minor.md#agent-memory-preflight-and-helper-path",
      "items": [
        "export:@byok-sdk/client/agent-memory#checkAgentMemoryHome"
      ]
    },
    {
      "id": "agent-memory-helper-path-resolver",
      "impact": "additive",
      "summary": "@byok-sdk/client/agent-memory exports resolveAgentMemoryFilesystemHelper for embedded Hosts that need the verified installed or relocated SDK helper path.",
      "migration": "docs/releases/host-upgrade-next-minor.md#agent-memory-preflight-and-helper-path",
      "items": [
        "export:@byok-sdk/client/agent-memory#resolveAgentMemoryFilesystemHelper"
      ]
    },
    {
      "id": "codex-task-mcp-allowlist",
      "impact": "breaking",
      "summary": "Codex exposes only the exact local approveTools for each injected Host server. Add explicit grants for tools that previously ran through readOnlyHint or ad hoc approval. Rename colliding user or injected servers under inherit and upgrade Codex to at least 0.48.0 for toolset offers.",
      "migration": "docs/releases/host-upgrade-next-minor.md#codex-task-mcp-allowlists",
      "items": [
        "behavior:codex-task-mcp-allowlist"
      ]
    },
    {
      "id": "codex-task-mcp-version-floor",
      "impact": "breaking",
      "summary": "CodexAdapter declines offers requiring MCP toolsets before claim if the local CLI version predates 0.48.0 or cannot be determined.",
      "migration": "docs/releases/host-upgrade-next-minor.md#codex-task-mcp-allowlists",
      "items": [
        "export:@byok-sdk/client#CodexAdapter",
        "export:@byok-sdk/client/adapters#CodexAdapter"
      ]
    },
    {
      "id": "inspect-store-service-state",
      "impact": "additive",
      "summary": "Embedded Hosts can inspect the lifecycle owner’s service and the daemon lock with inspectStoreServiceState before recovering a specific store. Proceed only on stopped and hold exclusive ownership through the write.",
      "migration": "packages/client/README.md#service-state-for-a-store-directory",
      "items": [
        "export:@byok-sdk/client#inspectStoreServiceState",
        "export:@byok-sdk/client#StoreServiceState"
      ]
    }
  ],
