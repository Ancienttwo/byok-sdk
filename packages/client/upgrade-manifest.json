  "entries": [
    {
      "id": "k8-room-turn-read-only-memory",
      "impact": "breaking",
      "summary": "K8 freezes a room Turn with read-only Agent memory. read-write becomes read, read-write-if-admitted becomes read-if-admitted, and a template without agentMemory freezes as read-if-admitted, so a room Turn loses memory_save. Other Turns keep the template value. A room Turn of a template without agentMemory now needs a device that advertises agent-memory-selection and agent-memory-read-if-admitted. A Host that vendors K8 copies src/rules/sync.ts.",
      "migration": "examples/bot-collaboration/README.md#group-chat-and-main-bot",
      "items": [
        "example:bot-collaboration"
      ]
    },
    {
      "id": "protocol-build-handoff-pack",
      "impact": "additive",
      "summary": "buildHandoffPack builds a bounded conversation handoff from turns that a Host holds; nothing calls it for a Host. truncateUtf8 is the text cut that it shares with boundFailureReason, whose output does not change.",
      "migration": "https://github.com/Ancienttwo/byok-sdk/issues/1441",
      "items": [
        "export:@byok-sdk/protocol#HANDOFF_EXCERPT_LINE_MAX_BYTES",
        "export:@byok-sdk/protocol#HandoffJson",
        "export:@byok-sdk/protocol#HandoffLine",
