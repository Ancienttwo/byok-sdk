  "entries": [
    {
      "id": "inspect-device-enrollment-clear",
      "impact": "additive",
      "summary": "Hosts can call inspectDeviceEnrollmentClear with the same options as clearDeviceEnrollment to check published store ownership and another store's enrollment or staged pairing attempt. The result is a point-in-time hint and the clear checks again under its own lease.",
      "migration": "https://github.com/Ancienttwo/byok-sdk/issues/2398",
      "items": [
        "export:@byok-sdk/client#inspectDeviceEnrollmentClear"
      ]
    },
    {
      "id": "embedded-input-image-upload",
      "impact": "additive",
      "summary": "A trusted Host can upload a committed input image through ByokServer.blobs.uploadInputImage and pass the returned ref to dispatch or steer. Use images up to 20 MiB and respect any lower server blob limit.",
      "migration": "packages/server/README.md#task-input-images",
      "items": [
        "export:@byok-sdk/client#BlobClient",
        "export:@byok-sdk/cloud#ByokCloudOptions",
        "export:@byok-sdk/protocol#INPUT_IMAGE_MAX_BYTES",
        "export:@byok-sdk/server#ByokServer",
        "export:@byok-sdk/server#InputImageUploadError",
        "export:@byok-sdk/server#UploadInputImage"
      ]
    },
    {
      "id": "offline-provider-secret-recovery",
      "impact": "additive",
      "summary": "List provider credential entry names from a recognized offline store. Before deleting obsolete credentials, exclude names used by active stores in the same credential scope.",
      "migration": "packages/keys/README.md#recover-provider-credentials-from-an-offline-store",
      "items": [
        "export:@byok-sdk/keys#listProviderProfileSecretNames"
      ]
    },
    {
      "id": "result-mcp-identifiers",
      "impact": "additive",
      "summary": "Hosts can import AGENT_RESULT_MCP_SERVER_NAME and AGENT_RESULT_TOOL_NAME from @byok-sdk/client to identify result submissions in event.mcp.",
      "migration": "https://github.com/Ancienttwo/byok-sdk/issues/2393",
      "items": [
        "export:@byok-sdk/client#AGENT_RESULT_MCP_SERVER_NAME",
        "export:@byok-sdk/client#AGENT_RESULT_TOOL_NAME"
      ]
    },
    {
      "id": "task-result-memory-change",
      "impact": "additive",
      "summary": "Hosts can read TaskResult.agentHomeMemoryChange from @byok-sdk/server for memory-reader evidence reported in the terminal frame; it is absent for writer passes.",
      "migration": "https://github.com/Ancienttwo/byok-sdk/issues/2394",
      "items": [
        "export:@byok-sdk/server#TaskResult"
      ]
    }
  ],
