        "export:@byok-sdk/client#suggestedRuntimeVersions"
      ]
    },
    {
      "id": "harness-service-tier",
      "impact": "additive",
      "summary": "Wire v8 Hosts can request a service tier and authorize default-tier fallback on Codex and Claude. Check device and harness support, and read the applied tier in task activity.",
