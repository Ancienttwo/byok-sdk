  "entries": [
    {
      "id": "local-tool-approval-host-only",
      "impact": "breaking",
      "summary": "Tool-authorization approvals are Host-only by default (#1101): the control socket and byok-agent approve can no longer approve them; rejection is unaffected. Set DaemonConfig.localToolApproval: 'allow' to restore local tool-authorization approval.",
      "migration": "docs/security.md#3-shared-approval-path",
      "items": [
        "export:@byok-sdk/client#APPROVAL_REQUIRES_HOST",
        "export:@byok-sdk/client#ApprovalKind",
        "export:@byok-sdk/client#DaemonConfig",
        "export:@byok-sdk/client#DiagnosticsSnapshot",
        "export:@byok-sdk/client#LocalToolApprovalPolicy"
      ]
    },
    {
      "id": "storage-retention-bounds",
      "impact": "breaking",
      "summary": "Every retention class declares a bound (#1105). The SDK now expires Pi's own session files in DaemonConfig.piByokLauncher.sessionDir (class pi-session-dir, 31 days by last write) and -task- terminal evidence in each Agent home (class terminal-evidence, 30 days); both moved from ProtectedClassId to ExpiringClassId, and the never-populated retired-namespace class is gone. New protected class runtime-session-external registers runtime session records outside the Agent home. storage.retention.ttlMs['pi-session-dir'] must be at least ttlMs['session-ledger'] plus one day, else LocalStorageConfigError. A Host that trimmed the Pi session folder itself deletes that code; a Host that raised the session-ledger TTL raises the pi-session-dir TTL too.",
      "migration": "docs/host-local-storage-layout.md#retention-bounds",
      "items": [
        "export:@byok-sdk/client#ExpiringClassId",
        "export:@byok-sdk/client#ProtectedClassId",
        "export:@byok-sdk/client#resolveStorageConfig"
      ]
    }
  ],
