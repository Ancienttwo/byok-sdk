  "entries": [
    {
      "id": "bot-collaboration-ledger-precheck",
      "impact": "breaking",
      "summary": "The local bot-collaboration entry exports inspectLedger(path, tenant), a read-only precheck returning StoreCompatibility. It reports migration-required for would-do rows without turnId; run migrateWouldDo after snapshot and before serving. LocalStoreId gains bot-collaboration-ledger; Hosts with exhaustive switches or Record<LocalStoreId, ...> must add this member.",
      "migration": "docs/releases/host-upgrade-next-minor.md#ledger-precheck-and-store-id-1981",
      "items": [
        "export:@byok-sdk/bot-collaboration#inspectLedger",
        "export:@byok-sdk/core#LocalStoreId",
        "store:bot-collaboration-ledger"
      ]
    },
    {
      "id": "bot-turn-instruction-host-kit",
      "impact": "additive",
      "summary": "Host adapters can compute the instruction frozen by K8 sync with botTurnInstruction on the host-kit entry, using an options object and InstructionLimits.",
      "migration": "https://github.com/Ancienttwo/byok-sdk/issues/1978",
      "items": [
        "export:@byok-sdk/bot-collaboration/host-kit#botTurnInstruction",
        "export:@byok-sdk/bot-collaboration/host-kit#BotTurnInstructionOptions",
        "export:@byok-sdk/bot-collaboration/host-kit#InstructionLimits",
        "export:@byok-sdk/bot-collaboration/rules#SyncOptions"
      ]
    },
    {
      "id": "keys-secret-corrupted-code",
      "impact": "breaking",
      "summary": "macOS Keychain and Linux Secret Service report an SDK entry that does not decode as the new KEYCHAIN_SECRET_CORRUPTED instead of KEYCHAIN_SECRET_DECODE_FAILED, and ProviderRegistry.replaceSecret/configure overwrite it with a new key. KEYCHAIN_SECRET_DECODE_FAILED now means an entry the SDK did not write; the registry never overwrites it and refuses before any write. A Host that offered 'enter the key again' for KEYCHAIN_SECRET_DECODE_FAILED offers it for KEYCHAIN_SECRET_CORRUPTED and shows delete, rename or other-profile guidance for KEYCHAIN_SECRET_DECODE_FAILED.",
      "migration": "docs/releases/host-upgrade-next-minor.md#provider-key-changes-roll-back-on-failure-1946",
      "items": [
        "export:@byok-sdk/keys#BYOK_KEYS_ERROR_CODES"
      ]
    }
  ],
