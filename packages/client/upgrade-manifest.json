    {
      "id": "server-host-mcp-task-context",
      "impact": "additive",
      "summary": "@byok-sdk/server adds the off-by-default CreateByokServerOptions.hostMcpTaskContext switch and verifyHostMcpTaskAssertion (with HostMcpTaskAssertionError) to declare host-mcp-task-context via @byok-sdk/cloud capabilityDeclarationForPorts and verify spec §8.2(2) and §8.2(3) in one fail-closed entry.",
      "migration": "https://github.com/Ancienttwo/byok-sdk/issues/2559",
      "items": [
        "export:@byok-sdk/cloud#capabilityDeclarationForPorts",
        "export:@byok-sdk/server#AuthenticatedTaskAssertion",
        "export:@byok-sdk/server#CreateByokServerOptions",
        "export:@byok-sdk/server#DeviceAssertionReplayAuthority",
        "export:@byok-sdk/server#HostMcpTaskAssertionError",
        "export:@byok-sdk/server#HostMcpTaskAssertionErrorCode",
        "export:@byok-sdk/server#HostMcpTaskContextOptions",
        "export:@byok-sdk/server#VerifyHostMcpTaskAssertionInput",
        "export:@byok-sdk/server#verifyHostMcpTaskAssertion"
      ]
    },
    {
      "id": "cursor-agent-cli",
      "impact": "additive",
      "summary": "CursorAdapter adds an opt-in Cursor Agent CLI harness on macOS and Linux. It uses the device user's CLI login. Phase 1 has fake-CLI coverage.",
      "migration": "docs/releases/host-upgrade-next-minor.md#cursor-agent-cli-2514",
      "items": [
        "config:runtimes",
        "export:@byok-sdk/client#CursorAdapter",
        "export:@byok-sdk/client#CursorAdapterOptions",
        "export:@byok-sdk/client/adapters#CursorAdapter",
        "export:@byok-sdk/client/adapters#CursorAdapterOptions",
        "export:@byok-sdk/client/adapters#RuntimeAdaptersRuntimes"
      ]
    },
    {
      "id": "task-scoped-skills-wire",
      "impact": "additive",
      "summary": "Wire v8 adds optional requiredSkills (1-16 logical SkillId values) on Agent offers, gated on the device skill-selection capability flag, alongside optional RuntimeCapabilities.skills discovery in conn.hello, presence, and task.claim. Prepared offers and nativeSessions refuse requiredSkills.",
      "migration": "docs/spec.md#task-scoped-skills",
      "items": [
        "export:@byok-sdk/protocol#CONFIGURED_SKILLS_MAX_ITEMS",
        "export:@byok-sdk/protocol#RequiredSkillsSchema",
        "export:@byok-sdk/protocol#RuntimeCapabilitiesSchema",
