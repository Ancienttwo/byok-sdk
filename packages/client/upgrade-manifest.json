    {
      "id": "node-24-22-3-floor",
      "impact": "breaking",
      "summary": "The public SDK packages require Node.js 24.22.3 or later via engines.node. Upgrade the Node runtime on Hosts and daemon machines before installing the new SDK.",
      "migration": "docs/releases/host-upgrade-next-minor.md#nodejs-24223-minimum",
      "items": [
        "behavior:node-24-22-3-floor"
      ]
    },
    {
      "id": "pi-161-closure",
      "impact": "breaking",
      "acceptance": "accept",
      "summary": "Re-prepare Pi inputs for the 1.6.1 closure and replace removed model IDs in the pinned keys catalog. Pi-durable 1.6.0 SQLite replicas open in place.",
      "migration": "docs/releases/host-upgrade-next-minor.md#pi-161-closure",
      "items": [
        "export:@byok-sdk/keys/pi-catalog#PI_MODEL_CATALOG_PI_AI_VERSION",
        "store:pi-durable"
      ]
    },
    {
      "id": "antigravity-print-mode-opt-in",
      "impact": "breaking",
      "summary": "@byok-sdk/client AgyAdapter.accountUsage requires allowPrintMode: true to read Antigravity quota. Pass it in the options or in the local runtimes.usage request to retain quota reads.",
      "migration": "docs/releases/host-upgrade-next-minor.md#oar-01381-2521",
      "items": [
        "behavior:antigravity-print-mode-opt-in"
      ]
    },
