        "export:@byok-sdk/protocol#AgentMemoryProjectionPlainReceipt",
        "export:@byok-sdk/protocol#AgentMemoryProjectionPlainReceiptSchema",
        "export:@byok-sdk/protocol#AgentMemoryProjectionReceiptSchema",
