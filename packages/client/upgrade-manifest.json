  "entries": [
    {
      "id": "daemon-when-capabilities-settled",
      "impact": "additive",
      "summary": "Daemon.whenCapabilitiesSettled({ signal }) awaits initial local memory backend proof, deployment capability discovery, and server HTTP-200 conn.hello acknowledgment for an open connection generation, returning DaemonCapabilitiesSettlement (with DaemonMemoryBackendProofState and DaemonDeploymentDiscoveryState) or disconnected on mid-proof reconnect; @byok-sdk/server MachineInfo projects readonly capabilities?: readonly CapabilityFlag[] from accepted conn.hello handshakes. The Daemon member is required, so a Host test double typed as Daemon adds it (#2471).",
      "migration": "docs/releases/host-upgrade-next-minor.md#settled-device-capabilities-2471",
      "items": [
        "export:@byok-sdk/client#Daemon",
        "export:@byok-sdk/client#DaemonCapabilitiesSettlement",
        "export:@byok-sdk/client#DaemonDeploymentDiscoveryState",
        "export:@byok-sdk/client#DaemonMemoryBackendProofState",
        "export:@byok-sdk/server#MachineInfo"
      ]
    },
    {
      "id": "detect-signal-prepare-detected",
      "impact": "additive",
      "summary": "@byok-sdk/client built-in adapters declare detect(signal?: AbortSignal); an abort rejects with the reason and stops any probe child. RuntimeAdapterPrepareInput.detected carries the offer's admission observation; a built-in prepare() reuses one produced by the same adapter, once, and launches the command it probed. No Host action required.",
      "migration": "docs/releases/host-upgrade-next-minor.md#detect-signal-prepare-detected",
      "items": [
        "export:@byok-sdk/client#AgyAdapter",
        "export:@byok-sdk/client#ClaudeAdapter",
        "export:@byok-sdk/client#CodexAdapter",
        "export:@byok-sdk/client#DshAdapter",
        "export:@byok-sdk/client#GrokAdapter",
        "export:@byok-sdk/client#OpenCodeAdapter",
        "export:@byok-sdk/client#PiAdapter",
        "export:@byok-sdk/client#RuntimeAdapterPrepareInput",
        "export:@byok-sdk/client/adapters#AgyAdapter",
        "export:@byok-sdk/client/adapters#ClaudeAdapter",
        "export:@byok-sdk/client/adapters#CodexAdapter",
        "export:@byok-sdk/client/adapters#DshAdapter",
        "export:@byok-sdk/client/adapters#GrokAdapter",
        "export:@byok-sdk/client/adapters#OpenCodeAdapter",
        "export:@byok-sdk/client/adapters#PiAdapter",
        "export:@byok-sdk/client/adapters#RuntimeAdapterPrepareInput"
      ]
    },
    {
      "id": "host-ledger-read",
      "impact": "additive",
      "summary": "@byok-sdk/server/execution-core adds readHostLedger(path), a read-only reader of every tenant of a K4 Host ledger that sees committed WAL frames from a private copy without writing or creating the database, WAL or SHM files. It returns HostLedgerRead: ok with HostLedgerTenantRead rows (HostLedgerReadState application, intents and executions, or a corrupt_row), absent, retryable (snapshot_changed, hot_journal) or unreadable (#2474).",
      "migration": "docs/releases/host-upgrade-next-minor.md#host-ledger-reader-2474",
      "items": [
        "export:@byok-sdk/server/execution-core#HostLedgerRead",
        "export:@byok-sdk/server/execution-core#HostLedgerReadState",
        "export:@byok-sdk/server/execution-core#HostLedgerTenantRead",
        "export:@byok-sdk/server/execution-core#readHostLedger"
      ]
    }
  ],
