  "entries": [
    {
      "id": "node-24-22-3-floor",
      "impact": "breaking",
      "summary": "The public SDK packages require Node.js 24.22.3 or later via engines.node. Upgrade the Node runtime on Hosts and daemon machines before installing the new SDK.",
      "migration": "docs/releases/host-upgrade-next-minor.md#nodejs-24223-minimum",
      "items": [
        "behavior:node-24-22-3-floor"
      ]
    },
    {
      "id": "pi-170-closure",
      "impact": "breaking",
      "acceptance": "accept",
      "summary": "Re-prepare Pi inputs and rebind Host accounting rulings for the 1.7.0 closure. Replace removed model IDs in the pinned keys catalog. Pi-durable 1.6.0 and 1.6.1 SQLite replicas open in place.",
      "migration": "docs/releases/host-upgrade-next-minor.md#pi-170-closure-2585",
      "items": [
        "export:@byok-sdk/keys/pi-catalog#PI_MODEL_CATALOG_PI_AI_VERSION",
        "store:pi-durable"
      ]
    },
    {
      "id": "antigravity-print-mode-opt-in",
      "impact": "breaking",
      "summary": "@byok-sdk/client AgyAdapter.accountUsage requires allowPrintMode: true to read Antigravity quota. Pass it in the options or in the local runtimes.usage request to retain quota reads.",
      "migration": "docs/releases/host-upgrade-next-minor.md#oar-01381-2521",
      "items": [
        "behavior:antigravity-print-mode-opt-in"
      ]
    },
    {
      "id": "antigravity-account-usage-options",
      "impact": "additive",
      "summary": "AgyAdapter.accountUsage and RuntimeAdapter.accountUsage accept RuntimeAccountUsageOptions. Handle print_mode_disabled when print mode is omitted or disabled. The qualified Antigravity CLI version is 1.5.18.",
      "migration": "docs/releases/host-upgrade-next-minor.md#oar-01381-2521",
      "items": [
        "export:@byok-sdk/client#AgyAdapter",
        "export:@byok-sdk/client#RuntimeAdapter",
        "export:@byok-sdk/client#UpgradeableRuntimeId",
        "export:@byok-sdk/client/adapters#AgyAdapter",
        "export:@byok-sdk/client/adapters#RuntimeAccountUsageOptions",
        "export:@byok-sdk/client/adapters#RuntimeAccountUsageUnsupportedReason",
        "export:@byok-sdk/client/adapters#RuntimeAdapter"
      ]
    },
    {
      "id": "suggested-runtime-versions",
      "impact": "additive",
      "summary": "Hosts can compare installed runtimes against OAR's bundled suggested minimums or validate a live manifest fetched on the Host's schedule.",
      "migration": "docs/releases/host-upgrade-next-minor.md#suggested-runtime-versions-2524",
      "items": [
        "export:@byok-sdk/client#SUGGESTED_RUNTIME_VERSIONS_URL",
