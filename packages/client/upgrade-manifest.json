  "entries": [
    {
      "id": "sqlite-snapshot-read",
      "impact": "additive",
      "summary": "@byok-sdk/core/sqlite-node exposes readSqliteSnapshot and SqliteSnapshotError to read committed WAL data on a private copy without changing the original files.",
      "migration": "packages/core/README.md#sqlite-snapshots",
      "items": [
        "export:@byok-sdk/core/sqlite-node#SqliteSnapshotError",
        "export:@byok-sdk/core/sqlite-node#readSqliteSnapshot"
      ]
    },
    {
      "id": "bot-ledger-hot-journal",
      "impact": "breaking",
      "summary": "@byok-sdk/bot-collaboration inspectLedger rejects a ledger with a potentially hot rollback journal instead of recovering it on a private copy. Recover the ledger before inspecting it.",
      "migration": "packages/bot-collaboration/README.md#ledger-compatibility",
      "items": [
        "behavior:bot-ledger-hot-journal"
      ]
    },
    {
      "id": "provider-store-credential-namespace",
      "impact": "breaking",
      "acceptance": "new-path-repair",
      "summary": "@byok-sdk/keys requires a credential namespace in each provider store. Existing stores return PROVIDER_STORE_SCHEMA_STALE. Preserve the old database, create a fresh store on a new path and re-enter provider keys. Automatic credential cleanup requires a recognized namespaced retired store.",
      "migration": "docs/releases/host-upgrade-next-minor.md#provider-store-credential-namespace",
      "items": [
        "export:@byok-sdk/keys#InMemoryProviderProfileStore",
        "export:@byok-sdk/keys#ProviderProfileStore",
        "export:@byok-sdk/keys#SqliteProviderProfileStore",
        "export:@byok-sdk/keys#removeRetiredProviderCredentials",
        "store:keys-profile-store"
      ]
    },
    {
      "id": "provider-credential-scope-binding",
      "impact": "breaking",
      "summary": "ProviderRegistry, applySealedProviderProvisioning, runPiProviderLauncher and the bundled Pi launcher scope the Host's base credential store to the selected database's namespace. Pass the base scope and upgrade the Host and launcher together.",
      "migration": "docs/releases/host-upgrade-next-minor.md#provider-store-credential-namespace",
      "items": [
        "behavior:provider-credential-scope-binding"
      ]
    },
    {
      "id": "model-discovery-connection-fields",
      "impact": "breaking",
      "summary": "ModelDiscoveryConnection uses auth_mode and base_url to match provider profiles. Remove providerKind from the connection object and keep adapter.",
      "migration": "docs/releases/host-upgrade-next-minor.md#model-discovery-connection-fields",
      "items": [
        "export:@byok-sdk/keys#ModelDiscoveryConnection"
      ]
    },
    {
      "id": "model-list-unreachable",
      "impact": "additive",
      "summary": "discoverProviderModels reports transport failures while connecting or reading a successful response body as MODEL_LIST_UNREACHABLE and preserves the original error as the cause.",
      "migration": "CHANGELOG.md#unreleased",
      "items": [
        "export:@byok-sdk/keys#BYOK_KEYS_ERROR_CODES"
      ]
    },
    {
      "id": "bot-testing-runner-injection",
      "impact": "breaking",
      "summary": "Each bot-collaboration testing vector now requires the Host's describe, it and expect as its first argument. Update every vector call to pass these test runner APIs, including the asymmetric matchers.",
      "migration": "packages/bot-collaboration/README.md#shared-vector-migration",
      "items": [
        "export:@byok-sdk/bot-collaboration/testing#VectorMatchers",
        "export:@byok-sdk/bot-collaboration/testing#VectorTestApi",
        "export:@byok-sdk/bot-collaboration/testing#cardCallVectors",
