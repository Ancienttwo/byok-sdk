        "export:@byok-sdk/bot-collaboration/rules#SyncOptions"
      ]
    },
    {
      "id": "service-store-release-failures",
      "impact": "breaking",
      "summary": "Store lease and gate release failures preserve a refused ServiceInstallationError and its code, with the refusal and all release failures in its AggregateError cause; Hosts that matched the 0.42.0 AggregateError on first install must read cause instead. When a release fails and an upgrade, rollback or recover receipt remains pending, the new store_release_failed code directs the Host to recover; restart the Host process first if the stuck lease causes store_busy.",
      "migration": "docs/releases/host-upgrade-next-minor.md#store-release-failures-name-the-next-step",
      "items": [
        "export:@byok-sdk/client#ServiceInstallationErrorCode"
      ]
    }
