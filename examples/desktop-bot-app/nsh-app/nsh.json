{
  "name": "BYOK Bots",
  "id": "io.byok-sdk.byok-desktop-bots",
  "version": "0.1.0",
  "build": 1,
  "singleInstance": true,
  "capabilities": {
    "application": true,
    "openUrl": {
      "schemes": ["https"]
    }
  },
  "tailwind": {
    "fontFamily": {
      "cjk": "Microsoft YaHei UI"
    }
  },
  "theme": {
    "cssVars": {
      "theme": {
        "radius": "0.625rem"
      },
      "light": {
        "background": "#f2f2f7",
        "foreground": "#000000",
        "card": "#ffffff",
        "card-foreground": "#000000",
        "popover": "#ffffff",
        "popover-foreground": "#000000",
        "primary": "#007aff",
        "primary-foreground": "#ffffff",
        "secondary": "rgba(120, 120, 128, 0.2)",
        "secondary-foreground": "#000000",
        "muted": "rgba(120, 120, 128, 0.2)",
        "muted-foreground": "rgba(60, 60, 67, 0.6)",
        "tertiary-foreground": "rgba(60, 60, 67, 0.3)",
        "accent": "rgba(120, 120, 128, 0.2)",
        "accent-foreground": "#000000",
        "destructive": "#ff3b30",
        "destructive-foreground": "#ffffff",
        "success": "#34c759",
        "success-foreground": "#ffffff",
        "warning": "#ff9500",
        "warning-foreground": "#ffffff",
        "border": "rgba(60, 60, 67, 0.29)",
        "input": "rgba(60, 60, 67, 0.29)",
        "ring": "#007aff",
        "segmented-thumb": "#ffffff",
        "chart-1": "#007aff",
        "chart-2": "#34c759",
        "chart-3": "#ff9500",
        "chart-4": "#ff3b30",
        "chart-5": "rgba(60, 60, 67, 0.6)",
        "sidebar": "#ffffff",
        "sidebar-foreground": "#000000",
        "sidebar-primary": "#007aff",
        "sidebar-primary-foreground": "#ffffff",
        "sidebar-accent": "rgba(120, 120, 128, 0.2)",
        "sidebar-accent-foreground": "#000000",
        "sidebar-border": "rgba(60, 60, 67, 0.29)",
        "sidebar-ring": "#007aff",
        "badge-primary": "color-mix(in srgb, var(--primary) 16%, transparent)",
        "badge-success": "color-mix(in srgb, var(--success) 16%, transparent)",
        "badge-warning": "color-mix(in srgb, var(--warning) 16%, transparent)",
        "badge-danger": "color-mix(in srgb, var(--destructive) 16%, transparent)",
        "host-starting": "var(--badge-primary)",
        "host-starting-foreground": "#000000",
        "host-running": "var(--badge-success)",
        "host-running-foreground": "#000000",
        "host-restarting": "var(--badge-warning)",
        "host-restarting-foreground": "#000000",
        "host-stopped": "rgba(120, 120, 128, 0.2)",
        "host-stopped-foreground": "#000000",
        "host-failed": "var(--badge-danger)",
        "host-failed-foreground": "#000000"
      },
      "dark": {
        "background": "#000000",
        "foreground": "#ffffff",
        "card": "#1c1c1e",
        "card-foreground": "#ffffff",
        "popover": "#2c2c2e",
        "popover-foreground": "#ffffff",
        "primary": "#0a84ff",
        "primary-foreground": "#ffffff",
        "secondary": "rgba(120, 120, 128, 0.36)",
        "secondary-foreground": "#ffffff",
        "muted": "rgba(120, 120, 128, 0.36)",
        "muted-foreground": "rgba(235, 235, 245, 0.6)",
        "tertiary-foreground": "rgba(235, 235, 245, 0.3)",
        "accent": "rgba(120, 120, 128, 0.36)",
        "accent-foreground": "#ffffff",
        "destructive": "#ff453a",
        "destructive-foreground": "#ffffff",
        "success": "#30d158",
        "success-foreground": "#ffffff",
        "warning": "#ff9f0a",
        "warning-foreground": "#ffffff",
        "border": "rgba(84, 84, 88, 0.6)",
        "input": "rgba(84, 84, 88, 0.6)",
        "ring": "#0a84ff",
        "segmented-thumb": "#636366",
        "chart-1": "#0a84ff",
        "chart-2": "#30d158",
        "chart-3": "#ff9f0a",
        "chart-4": "#ff453a",
        "chart-5": "rgba(235, 235, 245, 0.6)",
        "sidebar": "#1c1c1e",
        "sidebar-foreground": "#ffffff",
        "sidebar-primary": "#0a84ff",
        "sidebar-primary-foreground": "#ffffff",
        "sidebar-accent": "rgba(120, 120, 128, 0.36)",
        "sidebar-accent-foreground": "#ffffff",
        "sidebar-border": "rgba(84, 84, 88, 0.6)",
        "sidebar-ring": "#0a84ff",
        "badge-primary": "color-mix(in srgb, var(--primary) 24%, transparent)",
        "badge-success": "color-mix(in srgb, var(--success) 24%, transparent)",
        "badge-warning": "color-mix(in srgb, var(--warning) 24%, transparent)",
        "badge-danger": "color-mix(in srgb, var(--destructive) 24%, transparent)",
        "host-starting": "var(--badge-primary)",
        "host-starting-foreground": "#ffffff",
        "host-running": "var(--badge-success)",
        "host-running-foreground": "#ffffff",
        "host-restarting": "var(--badge-warning)",
        "host-restarting-foreground": "#ffffff",
        "host-stopped": "rgba(120, 120, 128, 0.36)",
        "host-stopped-foreground": "#ffffff",
        "host-failed": "var(--badge-danger)",
        "host-failed-foreground": "#ffffff"
      }
    }
  },
  "dependencies": {
    "byok-nsh-adapter": {
      "path": "ext/byok-nsh-adapter"
    }
  }
}
