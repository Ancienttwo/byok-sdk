{
  "name": "@byok-sdk/example-desktop-bot-app",
  "version": "0.0.1",
  "private": true,
  "description": "Private desktop reference app: Electron shell supervising a BYOK Host child over a private stdio bridge",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/renderer/index.html', 'dist/src/renderer/index.html')\"",
    "build:host": "node scripts/package/bundle-host.mjs --format cjs",
    "dev": "bun run build && bun run build:host && electron dist/src/main/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@byok-sdk/client": "workspace:*",
    "@byok-sdk/example-bot-collaboration": "workspace:*",
    "@byok-sdk/keys": "workspace:*",
    "@byok-sdk/server": "workspace:*"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "^24",
    "electron": "45.3.0",
    "esbuild": "0.28.1",
    "postject": "1.0.0-alpha.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
