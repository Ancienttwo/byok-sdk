{
  "name": "@byok-sdk/example-basic",
  "version": "0.0.1",
  "private": true,
  "description": "BYOK SDK end-to-end example: a hono server embedding @byok-sdk/server plus a plain-HTML demo UI, driven by a byok-agent daemon running the pi runtime",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@byok-sdk/server": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.11",
    "@byok-sdk/client": "workspace:*",
    "@byok-sdk/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "linkedom": "0.16.11",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
