# Hosted BYOK deployment — environment sample.
#
# Copy to `_ops/` (ignored) or into your secret manager and fill in. Every value
# below is a PLACEHOLDER: nothing in this file is, or may ever become, a real
# credential. `deploy/` is tracked, so a real secret committed here is a real
# secret published.
#
# Nothing reads this file automatically. It is the written-down contract of what
# a hosted composition needs, so an operator can see the whole surface at once
# rather than discovering it one crash at a time.

# ---------------------------------------------------------------------------
# Postgres — the transaction authority (deploy/sql/, @byok-sdk/cloud-postgres)
# ---------------------------------------------------------------------------

# Consumed by `deploy/scripts/migrate` and by the serving process's pool.
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE

# ---------------------------------------------------------------------------
# Object storage — the bytes (R2, or any S3-compatible endpoint)
# ---------------------------------------------------------------------------

# Origin only, no bucket and no trailing slash.
BYOK_S3_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
BYOK_S3_BUCKET=REPLACE_BUCKET_NAME

# `auto` is R2's own region. An S3-compatible endpoint that is not R2 wants its
# real region here — the adapter takes this as a required option precisely so a
# wrong-region signature fails at configuration review and not at upload time.
BYOK_S3_REGION=auto

# An R2 API token scoped to the ONE bucket above. Scope it there and nowhere
# else: this credential mints upload and download URLs for every tenant's
# objects, so its blast radius is the bucket it can reach.
BYOK_S3_ACCESS_KEY_ID=REPLACE_ACCESS_KEY_ID
BYOK_S3_SECRET_ACCESS_KEY=REPLACE_SECRET_ACCESS_KEY

# How long a minted upload or download URL stays valid, in seconds. Shorter is
# safer: a leaked URL is a bearer credential for one object until it expires.
BYOK_S3_PRESIGN_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Hosted device surface (@byok-sdk/cloud)
# ---------------------------------------------------------------------------

# HMAC secret for device access tokens. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Rotating it invalidates every outstanding access token; devices re-authenticate
# with their own keys, so a rotation costs a round trip, not a re-pairing.
BYOK_TOKEN_SIGNING_SECRET=REPLACE_BASE64_32_BYTES

# What this deployment declares it serves (ADR-010). A composition backed by
# object storage declares `blobs.presigned` and NOT `blobs.contentproxy`: it
# mints grants, and the device uploads straight to the object store, so there is
# no byte-proxy path to declare. Declaring one it cannot serve would be the
# over-declaration the capability split exists to make impossible.
BYOK_CAPABILITIES=events.longpoll,messages.batch,blobs.presigned

# Ceiling for a single declared blob, in bytes. Matches the reference server.
BYOK_MAX_BLOB_SIZE_BYTES=104857600
